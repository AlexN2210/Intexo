## Impexo — WordPress headless / WooCommerce

# Base URL du site WordPress (sans slash final)
VITE_WP_BASE_URL=https://ton-site-wordpress.com

# (Dev / test) Clés REST WooCommerce.
# ⚠️ En production, évite d’exposer le secret côté frontend:
# préfère un proxy backend (Edge/Node) qui signe les requêtes.
VITE_WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Active les produits mock (utile tant que l’API n’est pas prête)
VITE_IMPEXO_USE_MOCKS=true

# Utilise le proxy backend pour WooCommerce (recommandé en production)
# Le proxy protège les clés API côté serveur
VITE_USE_WC_PROXY=true

# URL du proxy API (par défaut: /api/woocommerce)
# VITE_WC_PROXY_URL=/api/woocommerce

# Si le front est hébergé ailleurs que Vercel (ex: www.impexo.fr en statique),
# indiquer l’URL du projet Vercel pour que le checkout appelle la bonne API.
# Ex: https://intexo-git-main-alexn2210s-projects.vercel.app
# VITE_CHECKOUT_API_BASE_URL=

# Stripe (WooCommerce Payments) — clé publique pour le formulaire carte
# pk_test_xxx en dev, pk_live_xxx en prod
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# --- Vercel (côté serveur, pour api/checkout/create-order) ---
# À définir dans Vercel → Project → Settings → Environment Variables
# WC_CONSUMER_KEY=ck_xxx
# WC_CONSUMER_SECRET=cs_xxx
# WP_BASE_URL=https://wp.impexo.fr
# (Optionnel) CORS_ORIGIN=https://www.impexo.fr

# --- WordPress wp-config.php (optionnel, pour sécuriser store-proxy.php) ---
# Mêmes valeurs que sur Vercel pour que checkout-full accepte le POST :
# define('WC_PROXY_CK', 'ck_xxx');
# define('WC_PROXY_CS', 'cs_xxx');
# Si ces constantes ne sont pas définies, store-proxy n’exige pas d’auth (risque si URL publique).

