{
  "version": 2,
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/checkout/create-order/index.js": { "memory": 256, "maxDuration": 30 },
    "api/woocommerce/[...path].js": { "memory": 512, "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/woocommerce/:path*", "destination": "/api/woocommerce/[...path]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}